{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/snissn/planar-jacobian/blob/main/governance/INTEGRATION-MANIFEST.schema.json",
  "title": "Planar Jacobian issue-packet integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_number",
    "leaf_id",
    "role",
    "owned_paths",
    "base_sha",
    "candidate_sha",
    "scientific_status",
    "review_mode",
    "reviewed_revision",
    "proposed_global_claims",
    "proposed_graph_nodes",
    "shared_surfaces_requested",
    "supersedes_prs",
    "temporary_artifacts_absent",
    "integration_state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "issue_number": {"type": "integer", "minimum": 1},
    "leaf_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["research-worker", "reviewer", "integration-maintainer", "governance-maintainer"]},
    "owned_paths": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scientific_status": {"type": "string", "minLength": 1},
    "review_mode": {"enum": ["none", "independent-review", "local-adversarial-review"]},
    "reviewed_revision": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "proposed_global_claims": {"type": "array", "items": {"type": "object"}},
    "proposed_graph_nodes": {"type": "array", "items": {"type": "object"}},
    "shared_surfaces_requested": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes_prs": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "temporary_artifacts_absent": {"const": true},
    "integration_state": {"enum": ["construction", "review", "integration-ready", "merged", "blocked"]},
    "pr_number": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "completion_receipt": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
  }
}
